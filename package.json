{
  "name": "bakvion",
  "private": true,
  "version": "0.2.3",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:web": "pnpm --filter @bakvion/web dev",
    "dev:desktop": "pnpm --filter @bakvion/desktop dev",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "test:database": "node tests/database/run.mjs",
    "format:check": "prettier --check .",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "eslint": "^10.14.0",
    "typescript-eslint": "^8.46.0",
    "@eslint/js": "^10.0.1",
    "globals": "^17.14.0",
    "@electric-sql/pglite": "^0.3.14",
    "prettier": "^3.6.2"
  }
}
