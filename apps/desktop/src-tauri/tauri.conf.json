{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bakvion",
  "version": "0.2.4",
  "identifier": "com.bakvion.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bakvion \u2014 Your Data. Always Protected.",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["msi"],
    "shortDescription": "Encrypted file-level backup and recovery",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
