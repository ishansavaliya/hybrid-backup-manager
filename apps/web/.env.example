# SMTP host (used from Project 3)
SMTP_HOST=
# SMTP port (used from Project 3)
SMTP_PORT=
# SMTP username (used from Project 3)
SMTP_USER=
# SMTP password (used from Project 3)
SMTP_PASS=
# SMTP from address (used from Project 3)
SMTP_FROM=
