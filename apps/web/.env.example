# Every server route calls serverEnv(), which reads ALL seven variables from
# SUPABASE_URL to CRON_SECRET below: if any one is missing, every route (device
# API, admin panel, cron) fails. Set all of them. The SMTP_* variables are not
# read yet (Project 3).
# Supabase project URL
SUPABASE_URL=
# Supabase secret (service role) key; server only
SUPABASE_SECRET_KEY=
# Admin panel username
BKP_ADMIN_USERNAME=
# Admin panel password
BKP_ADMIN_PASSWORD=
# Random secret used to sign admin session cookies
BKP_SESSION_SECRET=
# Ed25519 private key used to sign device licenses
LICENSE_SIGNING_PRIVATE_KEY=
# Bearer secret Vercel Cron sends to /api/cron/keepalive
CRON_SECRET=
# SMTP host (enquiry emails now; backup reports later)
SMTP_HOST=
# SMTP port (enquiry emails now; backup reports later)
SMTP_PORT=
# SMTP username (enquiry emails now; backup reports later)
SMTP_USER=
# SMTP password (enquiry emails now; backup reports later)
SMTP_PASS=
# SMTP from address (enquiry emails now; backup reports later)
SMTP_FROM=

# Optional. Where "Connect with Bakvion experts" enquiries are emailed (defaults to SMTP_USER).
LEADS_NOTIFY_EMAIL=
# Optional. Public URL of this site, used for the "Open Leads" link in enquiry emails.
PUBLIC_ADMIN_URL=
# Optional, public. Installer download link shown on the website; empty shows "Download coming soon".
NEXT_PUBLIC_DOWNLOAD_URL=
NEXT_PUBLIC_DOWNLOAD_VERSION=
NEXT_PUBLIC_DOWNLOAD_SIZE=
