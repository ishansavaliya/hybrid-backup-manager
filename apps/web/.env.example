# Supabase project URL
SUPABASE_URL=
# Supabase secret (service role) key; server only
SUPABASE_SECRET_KEY=
# Admin panel username
BKP_ADMIN_USERNAME=
# Admin panel password
BKP_ADMIN_PASSWORD=
